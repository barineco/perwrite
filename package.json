{
  "name": "perwrite",
  "displayName": "Perwrite",
  "description": "Obsidian-style inline Markdown editor with Mermaid, KaTeX, and Shiki highlighting",
  "version": "0.0.37",
  "publisher": "barineco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barineco/perwrite.git"
  },
  "keywords": [
    "markdown",
    "mermaid",
    "katex",
    "wysiwyg",
    "obsidian",
    "editor",
    "preview"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "enabledApiProposals": [
    "customEditorDiffs",
    "contribSourceControlHistoryItemMenu"
  ],
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "extensionDependencies": [
    "barineco.perwrite-theme-source"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Perwrite",
      "properties": {
        "perwrite.mermaidLayout": {
          "type": "string",
          "enum": [
            "elk",
            "dagre"
          ],
          "default": "elk",
          "description": "Layout engine for Mermaid diagrams."
        },
        "perwrite.mermaidMaxEdges": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 4096,
          "description": "Maximum number of edges allowed in one Mermaid diagram."
        },
        "perwrite.mermaidPanStep": {
          "type": "number",
          "default": 80,
          "minimum": 8,
          "maximum": 320,
          "description": "Distance in pixels moved by an arrow key in the expanded Mermaid view."
        },
        "perwrite.mermaidZoomStep": {
          "type": "number",
          "default": 1.5,
          "minimum": 1.1,
          "maximum": 3,
          "description": "Scale factor used by buttons, keyboard shortcuts, and one wheel notch in the expanded Mermaid view."
        },
        "perwrite.defaultViewMode": {
          "type": "string",
          "enum": [
            "raw",
            "rich",
            "render"
          ],
          "default": "render",
          "description": "Initial view mode when opening a document. Applies only to newly opened editors."
        },
        "perwrite.texRendering": {
          "type": "boolean",
          "default": true,
          "description": "Enable TeX parsing and rendering."
        },
        "perwrite.codeBlockWrap": {
          "type": "boolean",
          "default": true,
          "description": "Wrap fenced code block lines to the editor width. Disable to use horizontal scrolling inside code blocks."
        },
        "perwrite.lineHeight": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height for document text and blocks."
        },
        "perwrite.editorWidth": {
          "type": "number",
          "default": 960,
          "minimum": 480,
          "maximum": 2400,
          "description": "Maximum document width in pixels."
        },
        "perwrite.heading1Scale": {
          "type": "number",
          "default": 2,
          "minimum": 0.75,
          "maximum": 4,
          "description": "Font size multiplier for level 1 headings."
        },
        "perwrite.heading2Scale": {
          "type": "number",
          "default": 1.6,
          "minimum": 0.75,
          "maximum": 4,
          "description": "Font size multiplier for level 2 headings."
        },
        "perwrite.heading3Scale": {
          "type": "number",
          "default": 1.4,
          "minimum": 0.75,
          "maximum": 4,
          "description": "Font size multiplier for level 3 headings."
        },
        "perwrite.heading4Scale": {
          "type": "number",
          "default": 1.1,
          "minimum": 0.75,
          "maximum": 4,
          "description": "Font size multiplier for level 4 headings."
        },
        "perwrite.heading5Scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.75,
          "maximum": 4,
          "description": "Font size multiplier for level 5 headings."
        },
        "perwrite.heading6Scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.75,
          "maximum": 4,
          "description": "Font size multiplier for level 6 headings."
        },
        "perwrite.heading1LineHeight": {
          "type": "number",
          "default": 1.3,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier for level 1 headings."
        },
        "perwrite.heading2LineHeight": {
          "type": "number",
          "default": 1.35,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier for level 2 headings."
        },
        "perwrite.heading3LineHeight": {
          "type": "number",
          "default": 1.5,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier for level 3 headings."
        },
        "perwrite.heading4LineHeight": {
          "type": "number",
          "default": 1.7,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier for level 4 headings."
        },
        "perwrite.heading5LineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier for level 5 headings."
        },
        "perwrite.heading6LineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier for level 6 headings."
        },
        "perwrite.contentPadding": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 96,
          "description": "Horizontal document padding in pixels."
        },
        "perwrite.blockPadding": {
          "type": "number",
          "default": 16,
          "minimum": 0,
          "maximum": 96,
          "description": "Horizontal padding for code and math editing lines and blockquotes in pixels."
        },
        "perwrite.gutterGap": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 96,
          "description": "Gap between line numbers and document text in pixels."
        },
        "perwrite.mathBlockPadding": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 96,
          "description": "Horizontal padding inside rendered math blocks in pixels."
        },
        "perwrite.tableCellBlockPadding": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 48,
          "description": "Vertical padding inside table cells in pixels."
        },
        "perwrite.tableCellInlinePadding": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 64,
          "description": "Horizontal padding inside table cells in pixels."
        },
        "perwrite.tableWidgetBlockPadding": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 48,
          "description": "Vertical padding around table widgets in pixels."
        },
        "perwrite.mermaidBlockPadding": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 48,
          "description": "Padding inside Mermaid diagram blocks in pixels."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "perwrite.markdownEditor",
        "displayName": "Perwrite",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default",
        "diffEditorPriority": "default"
      }
    ],
    "commands": [
      {
        "command": "perwrite.revealTarget",
        "title": "Reveal Target",
        "category": "Perwrite"
      },
      {
        "command": "perwrite.openCommitComparison",
        "title": "Open Commit Comparison",
        "category": "Perwrite"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "perwrite.revealTarget",
          "when": "false"
        }
      ],
      "scm/historyItem/context": [
        {
          "command": "perwrite.openCommitComparison",
          "when": "scmProvider == git",
          "group": "inline"
        }
      ],
      "timeline/item/context": [
        {
          "command": "perwrite.openCommitComparison",
          "when": "timelineItem =~ /git:file:commit\\b/ && resourceExtname == .md",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs && pnpm --dir theme-source build",
    "watch": "node esbuild.config.mjs --watch && pnpm --dir theme-source watch",
    "package": "node esbuild.config.mjs --production && pnpm --dir theme-source build -- --production && pnpm dlx @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links && (cd theme-source && pnpm dlx @vscode/vsce package --no-dependencies --allow-missing-repository)",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/verify.mjs && node tests/browser/verify-webview.mjs && node tests/browser/verify-mermaid.mjs",
    "test:vscode-version": "node --test tests/browser/vscode-version.test.mjs",
    "test:vscodium-search-reveal": "node tests/browser/verify-search-target-reveal.mjs",
    "test:vscodium-code-block-wrap": "node tests/browser/verify-vscodium-code-block-wrap.mjs",
    "test:vscodium-rich-table-release": "node tests/browser/verify-vscodium-rich-table-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "heroicons": "2.2.0",
    "playwright-core": "1.55.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/common": "^1.5.0",
    "@lezer/markdown": "^1.4.0",
    "@mermaid-js/layout-elk": "^0.2.0",
    "katex": "^0.16.0",
    "mermaid": "^11.0.0",
    "shiki": "^1.0.0"
  }
}
